---
import { Icon } from "astro-icon/components";
const { title } = Astro.props;
---

<div class="relative my-12">
  <div class="relative w-full overflow-x-hidden">
    <div
      class="absolute h-px w-full bg-gradient-to-r from-white via-transparent to-white dark:from-neutral-950 dark:via-transparent dark:to-neutral-950"
    >
    </div>
    <div
      class="h-px w-full border-t border-dashed border-neutral-300 dark:border-neutral-600"
    >
    </div>
  </div>
  <div
    class="absolute left-1/2 -translate-x-1/2 -translate-y-1/2 flex h-auto w-auto items-center justify-center space-x-1 rounded-full border border-neutral-100 bg-white px-3 py-1.5 text-[0.6rem] uppercase tracking-widest text-neutral-400 shadow-sm dark:border-neutral-800 dark:bg-neutral-900"
  >
    <p class="leading-none">{title}</p>
    <div
      class="flex h-5 w-5 translate-x-1 items-center justify-center rounded-full border border-neutral-100 dark:border-neutral-800"
    >
      <Icon name="uim:angle-down" class="h-7 w-7" />
    </div>
  </div>
</div>
