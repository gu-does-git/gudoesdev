---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import ProjectImage from "../ProjectImage";

const allProjects = await getCollection("projects", ({ id, data: { featured } }) => {
  if (Astro.currentLocale) {
    const isValidLocale =
      Astro.currentLocale === "en"
        ? id.indexOf("/") == -1
        : id.includes(Astro.currentLocale);
    return isValidLocale && (featured ?? false);
  } else {
    return false;
  }
});

const projects = allProjects.slice(0, 3);
---

<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .project-card {
    animation: fadeInUp 0.6s ease-out forwards;
    opacity: 0;
  }

  .project-card:nth-child(1) { animation-delay: 0.1s; }
  .project-card:nth-child(2) { animation-delay: 0.2s; }
  .project-card:nth-child(3) { animation-delay: 0.3s; }

  .project-card:hover {
    transform: translateY(-4px);
  }
</style>

<section class="mx-auto max-w-4xl px-7 lg:px-0">
  <h2
    class="text-2xl font-bold leading-10 tracking-tight text-neutral-900 dark:text-neutral-100"
  >
    {Astro.currentLocale === "en" ? `My Projects` : `Meus projetos`}
  </h2>
  <p class="mb-6 text-base text-neutral-600 dark:text-neutral-400">
    {
      Astro.currentLocale === "en"
        ? `Here are some of my recent projects. I'm always working on something new, so
    check back often!`
        : `Aqui esta uma lista de alguns dos meus projetos. Estou sempre trabalhando em algo novo, então cheque sempre que quiser!`
    }
  </p>
  <div
    class="mt-7 grid w-full grid-cols-1 items-stretch gap-7 sm:grid-cols-2 md:grid-cols-3"
  >
    {
      projects.map(project => (
        <a
          href={project.data.url}
          target="_blank"
          class="project-card h-100 group relative flex flex-col items-stretch rounded-2xl p-3 transition-transform duration-300 ease-out sm:p-7"
        >
          <span class="absolute inset-0 z-20 block h-full w-full rounded-2xl border border-dashed border-transparent bg-transparent duration-300 ease-out group-hover:-translate-x-1 group-hover:-translate-y-1 group-hover:border group-hover:border-dashed group-hover:border-neutral-300 group-hover:bg-white dark:group-hover:border-neutral-600 dark:group-hover:bg-neutral-950" />
          <span class="absolute inset-0 z-10 block h-full w-full rounded-2xl border border-dashed border-neutral-300 duration-300 ease-out group-hover:translate-x-1 group-hover:translate-y-1 dark:border-neutral-600" />
          <span class="relative z-30 block duration-300 ease-out group-hover:-translate-x-1 group-hover:-translate-y-1">
            <span class="block w-full">
              <ProjectImage
                client:load
                projectUrl={project.data.url}
                alt={project.data.name}
                width={1200}
                height={675}
                className="aspect-[16/9] h-auto w-full rounded-lg"
              />
            </span>
            <span class="mb-1 mt-5 block w-full px-1 sm:mt-3">
              <span class="mb-0 flex items-center text-base font-semibold tracking-tight text-neutral-900 dark:text-neutral-100">
                <Image
                  width={24}
                  height={24}
                  src={`https://icon.horse/icon/${new URL(project.data.url).hostname}`}
                  class="mr-2 inline-block rounded-full"
                  alt={
                    Astro.currentLocale === "en"
                      ? "Project icon"
                      : "Icone do projeto"
                  }
                />
                <span>{project.data.name}</span>
                <Icon
                  name="uim:arrow-up-right"
                  class="ml-1 -translate-x-1 translate-y-1 opacity-0 transition group-hover:translate-x-0 group-hover:translate-y-0 group-hover:opacity-100"
                />
              </span>
              <span class="text-sm text-neutral-600 dark:text-neutral-400">
                {project.data.description}
              </span>
            </span>
          </span>
        </a>
      ))
    }
  </div>
  <div class="flex w-full items-center justify-center py-5">
    <a
      href="/projects"
      class="mt-5 inline-flex w-auto rounded-full border border-neutral-900 bg-neutral-900 px-4 py-2 text-xs font-semibold text-neutral-100 duration-300 ease-out hover:border-neutral-700 hover:bg-white hover:text-neutral-900 dark:bg-white dark:text-neutral-900 dark:hover:border-neutral-300 dark:hover:bg-black dark:hover:text-white"
    >
      {
        Astro.currentLocale === "en"
          ? `View all my projects`
          : `Ver todos meus projetos`
      }
    </a>
  </div>
</section>
