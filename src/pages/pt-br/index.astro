---
import Layout from "../../layouts/Layout.astro";
import socials from "../../content/etc/socials.json";

import { Icon } from "astro-icon/components";
---

<Layout title="Bem-vindo!">
  <main>
    <div
      class="relative z-20 mx-auto mt-16 w-full max-w-4xl px-7 md:mt-24 lg:mt-32 xl:px-0"
      role="main"
      aria-label="Bem-vindo!"
    >
      <div class="flex flex-col items-center md:flex-row">
        <div class="relative w-full md:w-2/3">
          <h1
            class="mb-5 text-4xl font-bold leading-tight dark:text-white md:text-4xl lg:text-6xl"
          >
            Olá, sou o Gustavo!
          </h1>
          <p
            class="mb-6 text-base text-neutral-600 dark:text-neutral-400"
            aria-label="Sou um engenheiro de software morando no Brasil. Meu foco principal é desenvolvimento web."
          >
            Sou um engenheiro de software morando no Brasil.
            <br class="hidden lg:block" />
            Meu foco principal é desenvolvimento web.
            <br class="hidden lg:block" />
            Atualmente trabalhando na
            <a
              class="decoration-clone text-green-600 underline transition-colors hover:text-green-700 dark:text-green-500 dark:hover:text-green-400"
              href="https://aoop.com.br/"
              aria-label="Aoop Cloud Solutions"
              target="_blank"
            >
              Aoop Cloud Solutions
            </a>
          </p>
          <p
            class="mb-2 font-semibold text-neutral-800 dark:text-neutral-200"
            aria-label="Eu posso te ajudar com"
          >
            Eu posso te ajudar com:
          </p>
          <ul
            class="mb-6 list-inside list-disc space-y-[3px] py-2 text-sm text-neutral-500 dark:text-neutral-400"
          >
            <li>Consultoria do ServiceNow</li>
            <li>Desenvolvimento de sites</li>
            <li>Desenvolvimento de aplicativos</li>
            <li>Gerenciamento de produtos</li>
            <li>e muito mais...</li>
          </ul>
          <div class="social-wrapper flex flex-row items-center">
            <div
              class="social-links mr-3 font-semibold text-neutral-800 dark:text-neutral-200"
              aria-label="Links sociais"
            >
              Links sociais:
            </div>
            <div class="social-icons flex gap-2">
              {
                socials.map(item => (
                  <a
                    href={item.href}
                    title={`Perfil do ${item.name}`}
                    target="_blank"
                    aria-label={`Perfil do ${item.name}`}
                    class="transition-colors hover:text-green-600 dark:hover:text-green-500"
                  >
                    <Icon name={item.icon} class="h-7 w-7" />
                  </a>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Collections List -->
    <!-- <Demo /> -->
  </main>
</Layout>
