---
import Layout from "../layouts/Layout.astro";
import Separator from "../components/Index/Separator.astro";
import socials from "../content/etc/socials.json";

import { Icon } from "astro-icon/components";
import Projects from "../components/Index/Projects.astro";
import Statistics from "../components/Index/Statistics.astro";
import TechStack from "../components/Index/TechStack.astro";
---

<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes slideInRight {
    from {
      opacity: 0;
      transform: translateX(-20px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .animate-fade-in-up {
    animation: fadeInUp 0.6s ease-out forwards;
  }

  .animate-slide-in-right {
    animation: slideInRight 0.6s ease-out forwards;
  }

  .hero-title {
    animation: fadeInUp 0.6s ease-out forwards;
  }

  .hero-description {
    animation: fadeInUp 0.6s ease-out forwards;
    animation-delay: 0.1s;
    opacity: 0;
  }

  .help-list li {
    animation: fadeInUp 0.6s ease-out forwards;
    opacity: 0;
  }

  .help-list li:nth-child(1) { animation-delay: 0.2s; }
  .help-list li:nth-child(2) { animation-delay: 0.25s; }
  .help-list li:nth-child(3) { animation-delay: 0.3s; }
  .help-list li:nth-child(4) { animation-delay: 0.35s; }
  .help-list li:nth-child(5) { animation-delay: 0.4s; }

  .social-wrapper {
    animation: fadeInUp 0.6s ease-out forwards;
    animation-delay: 0.45s;
    opacity: 0;
  }

  .social-icons a {
    transition: transform 0.3s ease, color 0.3s ease;
  }

  .social-icons a:hover {
    transform: translateY(-4px);
  }

  .company-link {
    transition: all 0.3s ease;
  }

  .company-link:hover {
    opacity: 0.8;
    transform: scale(1.02);
  }
</style>

<Layout title="Welcome!">
  <main>
    <div
      class="relative z-20 mx-auto mt-16 w-full max-w-4xl px-7 md:mt-24 lg:mt-32 xl:px-0"
      role="main"
      aria-label="Welcome message"
    >
      <div class="flex flex-col gap-12 md:flex-row md:gap-8">
        <div class="relative w-full md:w-2/3">
          <h1
            class="hero-title mb-5 text-4xl font-bold leading-tight dark:text-white md:text-4xl lg:text-6xl"
            id="welcome-message"
          >
            Hello, I'm Gustavo!
          </h1>
          <p
            class="hero-description mb-6 text-base text-neutral-600 dark:text-neutral-400"
            aria-label="I'm a software engineer living in Brazil. I focus primarily on Web development. Currently working at Chaintech."
          >
            I'm a software engineer living in Brazil.
            <br class="hidden lg:block" />
            I focus primarily on Web development.
            <br class="hidden lg:block" />
            Currently working at
            <a
              class="company-link decoration-clone text-green-600 underline dark:text-green-500"
              href="https://chaintech.com.br/"
              aria-label="Chaintech"
              target="_blank"
            >
              Chaintech
            </a>
          </p>
          <p
            class="mb-2 font-semibold text-neutral-800 dark:text-neutral-200"
            aria-label="I can help you out with"
          >
            I can help you out with:
          </p>
          <ul
            class="help-list mb-6 list-inside list-disc space-y-[3px] py-2 text-sm text-neutral-500 dark:text-neutral-400"
          >
            <li>ServiceNow Consulting</li>
            <li>Website Development</li>
            <li>Mobile App Development</li>
            <li>Product Management</li>
            <li>and more...</li>
          </ul>
          <div class="social-wrapper flex flex-col gap-6">
            <div class="flex flex-row items-center gap-4">
              <div
                class="social-links font-semibold text-neutral-800 dark:text-neutral-200"
                aria-label="Social Links"
              >
                Social Links:
              </div>
              <div class="social-icons flex gap-3">
                {
                  socials.map(item => (
                    <a
                      href={item.href}
                      title={`${item.name} Profile`}
                      target="_blank"
                      aria-label={`${item.name} Profile`}
                      class="transition-colors hover:text-green-600 dark:hover:text-green-500"
                    >
                      <Icon name={item.icon} class="h-7 w-7" />
                    </a>
                  ))
                }
              </div>
            </div>
          </div>
        </div>
        <div class="flex w-full items-center justify-center md:w-1/3">
          <a
            href="mailto:gustavosantos361@gmail.com"
            class="w-fit rounded-lg border-2 border-green-600 px-6 py-2 font-semibold text-green-600 transition-all duration-300 hover:bg-green-600 hover:text-white dark:border-green-500 dark:text-green-500 dark:hover:bg-green-500 dark:hover:text-neutral-900"
          >
            Get in Touch
          </a>
        </div>
      </div>
    </div>

    <!-- Statistics Separator -->
    <Separator title="My Work" />

    <!-- Statistics -->
    <Statistics />

    <!-- Tech Stack Separator -->
    <Separator title="Tech Stack" />

    <!-- Tech Stack -->
    <TechStack />

    <!-- Projects Separator -->
    <Separator title="My Projects" />

    <!-- Projects -->
    <Projects />

    <!-- Collections List -->
    <!-- <Demo /> -->
  </main>
</Layout>
