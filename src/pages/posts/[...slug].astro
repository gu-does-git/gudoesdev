---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ id, data: { draft } }) => {
    return id.indexOf("/") === -1 && !draft;
  });

  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: any;
}

const { post } = Astro.props;
const { Content } = await post.render();
---

<Layout title={post.data.title} postId={post.id}>
  <main class="mx-auto max-w-4xl px-7 py-16 lg:py-24 lg:px-0">
    <article>
      <!-- Back link -->
      <a
        href="/posts"
        class="mb-8 inline-flex items-center text-sm font-medium text-neutral-600 transition-colors hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100"
      >
        ← Back to posts
      </a>

      <!-- Post header -->
      <header class="mb-8">
        <h1
          class="mb-4 text-4xl font-bold text-neutral-900 dark:text-neutral-100 lg:text-5xl"
        >
          {post.data.title}
        </h1>

        <div
          class="flex flex-wrap items-center gap-3 border-b border-neutral-200 pb-6 dark:border-neutral-700"
        >
          <span class="text-sm text-neutral-600 dark:text-neutral-400">
            {new Date(post.data.pubDatetime).toLocaleDateString("en-US", {
              year: "numeric",
              month: "long",
              day: "numeric",
            })}
          </span>

          <span class="text-neutral-300 dark:text-neutral-600">•</span>

          <span class="text-sm text-neutral-600 dark:text-neutral-400">
            By {post.data.author}
          </span>

          {post.data.modDatetime && (
            <>
              <span class="text-neutral-300 dark:text-neutral-600">•</span>
              <span class="text-xs text-neutral-500 dark:text-neutral-500">
                Updated{" "}
                {new Date(post.data.modDatetime).toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })}
              </span>
            </>
          )}
        </div>
      </header>

      <!-- Post content -->
      <div
        class="prose prose-neutral max-w-none dark:prose-invert prose-headings:font-bold prose-a:text-green-600 prose-a:underline dark:prose-a:text-green-500 prose-img:rounded-lg"
      >
        <Content />
      </div>

      <!-- Tags -->
      {post.data.tags && post.data.tags.length > 0 && (
        <footer class="mt-12 border-t border-neutral-200 pt-8 dark:border-neutral-700">
          <div class="flex flex-wrap gap-2">
            {post.data.tags.map((tag: string) => (
              <a
                href={`/posts/tags/${tag.toLowerCase().replace(/\s+/g, "-")}`}
                class="rounded-full bg-neutral-100 px-3 py-1 text-xs font-medium text-neutral-700 transition-colors hover:bg-green-600 hover:text-white dark:bg-neutral-800 dark:text-neutral-300 dark:hover:bg-green-600"
              >
                {tag}
              </a>
            ))}
          </div>
        </footer>
      )}
    </article>
  </main>
</Layout>
