---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const allPosts = await getCollection("posts", ({ id, data: { draft } }) => {
  return id.indexOf("/") === -1 && !draft;
});

// Get all unique tags with post counts
const tagMap = new Map<string, number>();
allPosts.forEach(post => {
  post.data.tags?.forEach(tag => {
    tagMap.set(tag, (tagMap.get(tag) || 0) + 1);
  });
});

const tags = Array.from(tagMap.entries())
  .sort((a, b) => b[1] - a[1])
  .map(([tag, count]) => ({ tag, count }));
---

<Layout title="Tags">
  <main class="mx-auto max-w-4xl px-7 py-16 lg:py-24 lg:px-0">
    <div class="mb-12">
      <h1 class="mb-4 text-4xl font-bold dark:text-white lg:text-5xl">
        Tags
      </h1>
      <p class="text-base text-neutral-600 dark:text-neutral-400">
        Browse all blog post tags and explore posts by topic.
      </p>
    </div>

    {tags.length > 0 ? (
      <div class="flex flex-wrap gap-3">
        {tags.map(({ tag, count }) => (
          <a
            href={`/posts/tags/${tag.toLowerCase().replace(/\s+/g, "-")}`}
            class="group inline-flex items-center gap-2 rounded-full bg-neutral-100 px-4 py-2 transition-all duration-300 hover:bg-green-600 dark:bg-neutral-800 dark:hover:bg-green-600"
          >
            <span class="text-sm font-medium text-neutral-900 transition-colors group-hover:text-white dark:text-neutral-100">
              {tag}
            </span>
            <span class="rounded-full bg-neutral-200 px-2 py-0.5 text-xs font-semibold text-neutral-700 transition-colors group-hover:bg-white/20 group-hover:text-white dark:bg-neutral-700 dark:text-neutral-300">
              {count}
            </span>
          </a>
        ))}
      </div>
    ) : (
      <p class="text-center text-neutral-600 dark:text-neutral-400">
        No tags found yet.
      </p>
    )}
  </main>
</Layout>
